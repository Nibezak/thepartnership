                  justifyContent: 'center',
                  zIndex: 10,
                  opacity: 1
                }}
                animate={{ x: xSeq, y: ySeq, rotate: rotateSeq, opacity: 1 }}
                transition={{ duration: 40, repeat: Infinity, ease: "linear", times: times }}
