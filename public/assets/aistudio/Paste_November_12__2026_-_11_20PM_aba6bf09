const Process = () => {
  const [scale, setScale] = useState(1);
  const [viewportWidth, setViewportWidth] = useState(1600);
  const [activeStepIndex, setActiveStepIndex] = useState(0);
  const targetRef = useRef<HTMLDivElement>(null);

  const { scrollYProgress } = useScroll({
    target: targetRef,
    offset: ["start start", "end end"]
  });

  useMotionValueEvent(scrollYProgress, "change", (latest) => {
    if (latest < 0.25) setActiveStepIndex(0);
    else if (latest < 0.5) setActiveStepIndex(1);
    else if (latest < 0.75) setActiveStepIndex(2);
    else setActiveStepIndex(3);
  });

  const [isMobile, setIsMobile] = useState(window.innerWidth <= 768);

  useEffect(() => {
    const handleResize = () => {
      const mobile = window.innerWidth <= 768;
      setIsMobile(mobile);
      if (mobile) {
        setScale(1);
        setViewportWidth(window.innerWidth);
      } else {
        const screenWidth = window.innerWidth;
        const screenHeight = window.innerHeight;
        const clientW = document.documentElement.clientWidth;
        setViewportWidth(clientW);
        let scaleX = screenWidth / 1600;
        let scaleY = screenHeight / 906;
        let newScale = Math.min(scaleX, scaleY);
        if (newScale > 1.2) newScale = 1.2;
        setScale(newScale);
      }
    };

    handleResize();
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, []);

  const steps = [
    { 
      name: 'Discover', 
      title: 'Discover', 
      desc: 'We start by understanding your brand from the inside out. We look at your goals, target audience, competitors, current social presence, and what makes your brand different.',
      design: <ProcessDiscoverDesign />
    },
    { 
      name: 'Strategize', 
      title: 'Strategize', 
      desc: 'We build a tailored roadmap designed to maximize your online impact, ensuring every post and campaign aligns perfectly with your overarching business objectives.',
      design: <ProcessStrategizeDesign />
    },
    { 
      name: 'Create & Launch', 
      title: 'Create & Launch', 
      desc: 'Our team crafts scroll-stopping content and launches targeted campaigns, bringing the strategy to life across all chosen social media platforms.',
      design: <ProcessCreateLaunchDesign />
    },
    { 
      name: 'Analyze & Grow', 
      title: 'Analyze & Grow', 
      desc: 'We continuously monitor performance, analyze key metrics, and optimize campaigns in real-time to ensure sustained, measurable growth for your brand.',
      design: <ProcessAnalyzeGrowDesign />
    }
  ];

  const metrics = [
    { value: '+185%', label: 'Engagement Growth' },
    { value: '+320%', label: 'Social Reach' },
    { value: '240%', label: 'Sales Growth' },
    { value: '500K+', label: 'Content Views' },
    { value: '4.9/5', label: 'Client Satisfaction' },
    { value: '95%', label: 'Client Retention' }
  ];

  const renderMetrics = () => (
    <>
      {metrics.map((metric, idx) => (
        <div key={idx} style={styles.metricGroup}>
          <span style={styles.metricValue}>{metric.value}</span>
          <span style={styles.metricLabel}>/ {metric.label}</span>
        </div>
      ))}
    </>
  );

  if (isMobile) {
    return (
      <div style={{ width: '100%', backgroundColor: '#024F47', padding: '60px 20px', boxSizing: 'border-box' }}>
        <style>
          {`
            @keyframes processMarquee {
              0% { transform: translateX(0); }
              100% { transform: translateX(-50%); }
            }
          `}
        </style>
        {/* Header Section */}
        <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: '20px', marginBottom: '40px' }}>
          <div style={styles.pillRow}>
            <div style={styles.pillSquare}></div>
            <span style={styles.pillText}>Our Process</span>
          </div>
          <motion.h2 
            style={{ ...styles.mainTitle, width: '100%', fontSize: '36px', lineHeight: '42px' }}
            initial="hidden"
            whileInView="visible"
            viewport={{ once: false, amount: 0.5 }}
            variants={{
              visible: { transition: { staggerChildren: 0.05 } },
              hidden: {}
            }}
          >
            {"Our Roadmap to Your Growth".split(" ").map((word, i, arr) => (
              <React.Fragment key={i}>
                <span style={{ overflow: 'hidden', display: 'inline-flex', verticalAlign: 'bottom' }}>
                  <motion.span
                    variants={{
                      hidden: { y: '100%', opacity: 0 },
                      visible: { y: 0, opacity: 1, transition: { duration: 0.6, ease: [0.22, 1, 0.36, 1] } }
                    }}
                  >
                    {word}
                  </motion.span>
                </span>
                {i < arr.length - 1 && ' '}
              </React.Fragment>
            ))}
          </motion.h2>
          <motion.p style={{ ...styles.subTitle, width: '100%' }}
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: false, amount: 0.5 }}
            transition={{ duration: 0.6, delay: 0.2 }}
          >
            Explore how we help brands turn creative ideas and smart social strategies into measurable results.
          </motion.p>
        </div>

        {/* Steps */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: '60px', marginBottom: '60px' }}>
          {steps.map((step, idx) => (
            <motion.div 
              key={idx}
              initial={{ opacity: 0, y: 50 }}
              whileInView={{ opacity: 1, y: 0 }}
